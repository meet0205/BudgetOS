{
  "name": "budgetos",
  "version": "0.0.0",
  "private": true,
  "description": "BudgetOS — personal budget planner & money management (Canada / Nova Scotia)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gen:seed-sql": "node scripts/gen-seed-sql.mjs",
    "db:push": "node scripts/db-push.mjs",
    "dev": "npm run dev --workspace @budgetos/desktop",
    "electron": "npm run electron --workspace @budgetos/desktop"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "typescript": "~5.3.3"
  }
}
